{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/ssr.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "dist/ehefin-fe/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://34.51.234.182/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "http://34.51.234.182/uploads/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/ehefin-fe/browser/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|jpeg|svg|woff|woff2|ttf|eot))",
      "dest": "/dist/ehefin-fe/browser/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
